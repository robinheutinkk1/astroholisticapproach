# ---------------------------------------------------------------------------
# Supabase — Project settings › API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses row level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Stripe — Developers › API keys, and Developers › Webhooks
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Email notifications (optional; the site works without them)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@holisticastroapproach.com
CONTACT_FROM_EMAIL=noreply@holisticastroapproach.com

# ---------------------------------------------------------------------------
# Public URL, used for canonical links, the sitemap and Stripe redirects
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://holisticastroapproach.com
